DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (recommended). Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# All tables are created in the `caster` schema (see config/settings.py),
# so this can safely point at a Postgres database/instance shared with
# other, unrelated projects without table or migration clashes.
DATABASE_URL=postgres://caster:caster@localhost:5432/caster

# Use a sqlite URL instead if you just want to run the landing page without
# setting up Postgres locally: DATABASE_URL=sqlite:///db.sqlite3

DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
